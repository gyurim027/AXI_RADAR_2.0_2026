# I-07 또는 I-02 조회와 해당 역할의 로그인을 명시적으로 연결한다. 다른 기능의 실제 연결을 의미하지 않는다.
# 기본값(미설정)은 기존 팀 화면 개발 모드다. 실제 연결 실패 시 목업으로 대체하지 않는다.
VITE_I07_API=false
VITE_SETTINGS_API=false
VITE_API_BASE_URL=http://127.0.0.1:8000

# 계정 관리·접속 기록·알림 설정(I-01·I-03·I-04)과 RADAR 운영자 로그인을 서버에 연결한다. 켜면 그 세 화면만 열린다.
VITE_OPS_API=false

# 개발용 빠른 로그인(로그인 화면 버튼)의 서버 시험 비밀번호. 각자 frontend/.env.local에만 넣는다. 저장소·배포 환경에는 넣지 않는다.
# 배포 전에 DevQuickLogin 파일과 LoginPage의 DEV-QUICK-LOGIN 표시를 지운다.
VITE_DEV_LOGIN_PASSWORD=
