# RADAR 2.0 공통 서버 환경변수 예시
# 이 파일을 .env로 복사한 뒤 값을 채운다:  Copy-Item .env.example .env
# .env는 저장소·채팅·문서에 올리지 않는다 (.gitignore에 들어 있음)

# ── 공용 DB (W05-02, SQL v2) ─────────────────────────────
# 강의실: 진규님 PC 공용 DB / 집: 내 PC MySQL에 SQL v2를 띄운 주소
RADAR_DB_HOST=
RADAR_DB_PORT=3306
RADAR_DB_USER=
RADAR_DB_PASSWORD=
RADAR_DB_NAME=mysqlteam02db
# RADAR_DB_SOCKET=              # 리눅스 소켓으로 붙을 때만

# ── 서버 ──────────────────────────────────────────────
RADAR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RADAR_APP_ENV=dev

# ── 로그인 (I-01) ────────────────────────────────────────
RADAR_JWT_SECRET=               # 토큰 서명 키 (긴 임의 글자). 비면 dev에서만 서버를 켤 때마다 임시 키
RADAR_TOKEN_HOURS=8             # 로그인 유지 시간
# RADAR_SEED_PASSWORD=          # 시험 계정 만들 때만 (scripts/auth_create_test_users.py). 보통은 터미널에서 잠깐 넣음

# ── 공통 LLM 모듈 (W05-05, 규림 제안 이름) ──────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_DEFAULT_ROUTE=internal
GEMINI_API_KEY=
GEMINI_MODEL=

# ── 기능별 ───────────────────────────────────────────
AI10_DEV_API_ENABLED=0          # 1이면 AI-10 개발용 쓰기 API 켜짐
VWORLD_KEY=                     # AI-03 (세은) 브이월드
